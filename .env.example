# Copy to .env for local runs. Never commit real values.
# Automated production currently defaults to Gemini because the existing API can use its free tier.
ANALYSIS_PROVIDER=gemini
GEMINI_API_KEY=
# Optional override; when blank the newest available Gemini Flash model is selected.
GEMINI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SEC asks automated clients to identify themselves. This is not a secret.
SEC_USER_AGENT=us-earnings-monitor/0.2 your-email@example.com
